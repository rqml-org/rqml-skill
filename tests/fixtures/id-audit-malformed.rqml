<?xml version="1.0" encoding="UTF-8"?>
<rqml xmlns="https://rqml.org/schema/2.1.0"
      version="2.1.0"
      docId="FIXTURE-ID-AUDIT-MALFORMED"
      status="draft">
  <meta>
    <title>ID Audit Malformed</title>
    <system>fixture-skill</system>
  </meta>
  <requirements>
    <req id="1BAD-ID" type="FR" title="Malformed id" status="approved" priority="must">
      <statement>The fixture SHALL contain a malformed id.</statement>
      <acceptance>
        <criterion id="CRIT-ID-001">
          <then>The audit reports the malformed identifier.</then>
        </criterion>
      </acceptance>
    </req>
  </requirements>
</rqml>
