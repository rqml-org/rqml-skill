<?xml version="1.0" encoding="UTF-8"?>
<rqml xmlns="https://rqml.org/schema/2.1.0"
      version="2.1.0"
      docId="FIXTURE-LINT-CERTIFIED"
      status="draft">
  <meta>
    <title>Lint Certified Missing Trace Metadata</title>
    <system>fixture-skill</system>
  </meta>
  <requirements>
    <reqPackage id="PKG-LINT" title="Lint package">
      <req id="REQ-LINT-001" type="FR" title="Has acceptance" status="approved" priority="must">
        <statement>The fixture SHALL include acceptance criteria and trace edges.</statement>
        <acceptance>
          <criterion id="CRIT-LINT-001">
            <then>The requirement satisfies baseline semantic checks.</then>
          </criterion>
        </acceptance>
      </req>
    </reqPackage>
  </requirements>
  <trace>
    <edge id="TR-LINT-001" type="implements">
      <from><locator><external uri="file:example.txt"/></locator></from>
      <to><locator><local id="REQ-LINT-001"/></locator></to>
    </edge>
  </trace>
</rqml>
