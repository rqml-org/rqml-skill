<?xml version="1.0" encoding="UTF-8"?>
<rqml xmlns="https://rqml.org/schema/2.1.0"
      version="2.1.0"
      docId="FIXTURE-TRACE-INVALID"
      status="draft">
  <meta>
    <title>Trace Invalid Doc Target</title>
    <system>fixture-skill</system>
  </meta>
  <requirements>
    <req id="REQ-TRACE-002" type="FR" title="Trace fixture invalid" status="approved" priority="must">
      <statement>The fixture SHALL contain an unresolved doc locator.</statement>
      <acceptance>
        <criterion id="CRIT-TRACE-002">
          <then>The resolver reports the missing target.</then>
        </criterion>
      </acceptance>
    </req>
  </requirements>
  <trace>
    <edge id="TR-TRACE-INVALID" type="dependsOn">
      <from><locator><local id="REQ-TRACE-002"/></locator></from>
      <to><locator><doc uri="missing-doc-target.rqml" id="REQ-MISSING-001"/></locator></to>
    </edge>
  </trace>
</rqml>
