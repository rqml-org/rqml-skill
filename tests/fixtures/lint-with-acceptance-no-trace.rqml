<?xml version="1.0" encoding="UTF-8"?>
<rqml xmlns="https://rqml.org/schema/2.1.0"
      version="2.1.0"
      docId="FIXTURE-LINT-NO-TRACE"
      status="draft">
  <meta>
    <title>Lint Missing Trace</title>
    <system>fixture-skill</system>
  </meta>
  <requirements>
    <reqPackage id="PKG-LINT" title="Lint package">
      <req id="REQ-LINT-001" type="FR" title="Has acceptance" status="approved" priority="must">
        <statement>The fixture SHALL include acceptance criteria.</statement>
        <acceptance>
          <criterion id="CRIT-LINT-001">
            <then>The requirement satisfies standard-mode acceptance checks.</then>
          </criterion>
        </acceptance>
      </req>
    </reqPackage>
  </requirements>
</rqml>
