<?xml version="1.0" encoding="UTF-8"?>
<rqml xmlns="https://rqml.org/schema/2.1.0"
      version="2.1.0"
      docId="FIXTURE-TRACE-EXTERNAL"
      status="draft">
  <meta>
    <title>Trace Valid External Target</title>
    <system>fixture-skill</system>
  </meta>
  <requirements>
    <req id="REQ-TRACE-003" type="FR" title="Trace external" status="approved" priority="must">
      <statement>The fixture SHALL contain a valid external locator.</statement>
      <acceptance>
        <criterion id="CRIT-TRACE-003">
          <then>The resolver accepts the external URI.</then>
        </criterion>
      </acceptance>
    </req>
  </requirements>
  <trace>
    <edge id="TR-TRACE-EXTERNAL" type="implements">
      <from><locator><external uri="https://example.com/spec/123"/></locator></from>
      <to><locator><local id="REQ-TRACE-003"/></locator></to>
    </edge>
  </trace>
</rqml>
