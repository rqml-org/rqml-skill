    <!-- Requirements depending on constraints -->
    <edge id="TR-SKILL-CON" type="dependsOn">
      <from><locator><local id="REQ-SKILL-MD"/></locator></from>
      <to><locator><local id="CON-AGENTSKILLS"/></locator></to>
    </edge>
    <edge id="TR-TOKEN-CON" type="dependsOn">
      <from><locator><local id="REQ-TOKEN-BUDGET"/></locator></from>
      <to><locator><local id="CON-TOKEN-BUDGET"/></locator></to>
    </edge>
