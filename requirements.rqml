      <from><locator><local id="REQ-XSD-VALIDATE"/></locator></from>
      <to><locator><local id="CON-XSD-COMPAT"/></locator></to>
    </edge>
    <edge id="TR-OFFLINE-CON" type="dependsOn">
      <from><locator><local id="REQ-OFFLINE"/></locator></from>
