<?xml version="1.0" encoding="UTF-8"?>
<rqml xmlns="https://rqml.org/schema/2.1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="https://rqml.org/schema/2.1.0 https://rqml.org/schema/rqml-2.1.0.xsd"
      version="2.1.0" docId="RQML-SKILL-001" status="draft">

  <meta>
    <title>RQML Agent Skill</title>
    <system>rqml-skill</system>
    <summary>Portable Agent Skills package that teaches coding agents to author, edit, validate, and reason about RQML documents across any skills-compatible host (Claude Code, OpenAI Codex, Cursor, GitHub Copilot, Gemini CLI, and others).</summary>
    <authors>
      <author>
        <name>Gardar Gudgeirsson</name>
        <role>Maintainer</role>
      </author>
    </authors>
  </meta>

  <catalogs>
    <actors>
      <actor id="ACT-AGENT" name="Coding agent"/>
      <actor id="ACT-DEVELOPER" name="Developer"/>
    </actors>
    <constraints>
      <constraint id="CON-AGENTSKILLS">
        <statement>SKILL.md must conform to the Agent Skills specification.</statement>
        <source>agentskills.io specification</source>
      </constraint>
      <constraint id="CON-XSD-COMPAT">
        <statement>Validation must succeed for any document whose declared rqml@version has a bundled schema in references/schemas/.</statement>
      </constraint>
      <constraint id="CON-OFFLINE">
        <statement>All core services must function without network access.</statement>
      </constraint>
      <constraint id="CON-LICENSE">
        <statement>Source code must be licensed under Apache-2.0 to match the upstream RQML standard and the Agent Skills standard.</statement>
      </constraint>
      <constraint id="CON-TOKEN-BUDGET">
        <statement>SKILL.md body must stay under 5000 tokens and 500 lines per the Agent Skills authoring guidance.</statement>
        <source>agentskills.io/specification</source>
      </constraint>
      <constraint id="CON-PYTHON-MIN">
        <statement>Scripts must run on Python 3.8 or later, the lowest version still in common agent runtimes.</statement>
      </constraint>
    </constraints>
    <risks>
      <risk id="RISK-SCHEMA-DRIFT" severity="medium">
        <statement>Bundled schemas drift from the canonical schemas served at rqml.org.</statement>
        <mitigation>CI fetches upstream schemas weekly and asserts byte-equality against bundled copies.</mitigation>
      </risk>
      <risk id="RISK-VERSION-SKEW" severity="medium">
        <statement>Projects copy AGENTS.md referencing schema 2.0.1 while the skill assumes 2.1.0, causing validation to fail or use the wrong rules.</statement>
        <mitigation>Auto-detect version from rqml@version and dispatch to the matching bundled schema; bundle multiple supported versions.</mitigation>
      </risk>
      <risk id="RISK-FALSE-PASS" severity="high">
        <statement>XSD validation passes on documents that are structurally valid but semantically broken (ambiguous statements, missing acceptance criteria, broken external trace targets).</statement>
        <mitigation>Layered semantic linter and trace resolver complement XSD validation; strictness level controls how aggressive the lint is.</mitigation>
      </risk>
      <risk id="RISK-TOOL-MISSING" severity="low">
        <statement>Neither xmllint nor lxml is available in the agent's runtime environment.</statement>
        <mitigation>Pure-Python xmlschema fallback bundled as third tier; clear install instructions emitted otherwise.</mitigation>
      </risk>
      <risk id="RISK-CONTEXT-BLOAT" severity="medium">
        <statement>SKILL.md grows over time and starts consuming significant context on every activation.</statement>
        <mitigation>Token-budget CI check on PRs; aggressive use of references/ for detail.</mitigation>
      </risk>
    </risks>
    <decisions>
      <decision id="DEC-REPO" status="approved">
        <context>Where the skill source lives relative to rqml.org (spec) and rqml.dev (toolset).</context>
        <decision>Separate repository under the rqml-org GitHub organization, prominently linked from rqml.org as the canonical agent integration and listed at rqml.dev among the tools. See ADR-0001.</decision>
      </decision>
      <decision id="DEC-BUNDLE" status="approved">
        <context>Whether to fetch schemas at runtime or bundle them in the skill.</context>
        <decision>Bundle every supported schema version in references/schemas/ for offline-safe validation. See ADR-0002.</decision>
      </decision>
      <decision id="DEC-FALLBACK" status="approved">
        <context>Validation tool availability varies across agent environments.</context>
        <decision>Try xmllint first (libxml2, ubiquitous), fall back to lxml, then to xmlschema (pure Python). See ADR-0003.</decision>
      </decision>
      <decision id="DEC-PYTHON" status="approved">
        <context>Choice of scripting language for executable services.</context>
        <decision>Python 3.8+ over Bash or Node.js because lxml and xmlschema are Python libraries and most agent runtimes have Python preinstalled. See ADR-0004.</decision>
      </decision>
      <decision id="DEC-AUTODETECT" status="approved">
        <context>The spec is at version 2.1.0 but AGENTS.md template and current GitHub release reference 2.0.1, so projects in the wild will use both.</context>
        <decision>Auto-detect from rqml@version and dispatch to the matching bundled schema; allow --schema-version override. See ADR-0005.</decision>
      </decision>
      <decision id="DEC-MIRROR" status="approved">
        <context>References content overlaps significantly with rqml.org docs.</context>
        <decision>Mirror by reference, not duplication: references/elements/*.md are agent-optimized condensations that link back to the canonical docs URL. See ADR-0006.</decision>
      </decision>
      <decision id="DEC-STRICTNESS" status="approved">
        <context>Strictness levels (relaxed, standard, strict, certified) shape what semantic checks should fire.</context>
        <decision>Read strictness at runtime from .rqml-skill.yaml or AGENTS.md; pass into lint scripts. See ADR-0007.</decision>
      </decision>
    </decisions>
    <policies>
      <policy id="POL-SKILL-SPEC" source="agentskills.io">
        <obligation>SKILL.md must include valid YAML frontmatter with at least name and description fields.</obligation>
      </policy>
      <policy id="POL-SEMVER" source="semver.org">
        <obligation>Skill versions follow semantic versioning; breaking changes to script CLIs require a major bump.</obligation>
      </policy>
    </policies>
  </catalogs>

  <domain>
    <entities>
      <entity id="ENT-SKILL" name="Skill">
        <attr id="ATTR-SKILL-NAME" name="name" type="string" required="true"/>
        <attr id="ATTR-SKILL-DESC" name="description" type="string" required="true"/>
        <attr id="ATTR-SKILL-VERSION" name="version" type="string" required="false"/>
      </entity>
      <entity id="ENT-RQMLDOC" name="RqmlDocument">
        <attr id="ATTR-DOC-VER" name="version" type="string" required="true"/>
        <attr id="ATTR-DOC-PATH" name="path" type="string" required="true"/>
      </entity>
      <entity id="ENT-XSD" name="BundledSchema">
        <attr id="ATTR-XSD-VERSION" name="version" type="string" required="true"/>
        <attr id="ATTR-XSD-PATH" name="path" type="string" required="true"/>
      </entity>
      <entity id="ENT-VALERR" name="ValidationError">
        <attr id="ATTR-ERR-LINE" name="line" type="integer" required="true"/>
        <attr id="ATTR-ERR-COL" name="column" type="integer" required="false"/>
        <attr id="ATTR-ERR-PATH" name="path" type="string" required="false"/>
        <attr id="ATTR-ERR-MSG" name="message" type="string" required="true"/>
        <attr id="ATTR-ERR-SEV" name="severity" type="token" required="true"/>
      </entity>
    </entities>
  </domain>

  <goals>
    <goal id="GOAL-PORTABILITY" title="Cross-host portability" priority="must">
      <statement>The skill works identically across all skills-compatible agent hosts without modification.</statement>
    </goal>
    <goal id="GOAL-CORRECTNESS" title="Reliable validation" priority="must">
      <statement>Validation results match xmllint --schema using the canonical RQML XSD for the document's declared version.</statement>
    </goal>
    <goal id="GOAL-OFFLINE" title="Offline operation" priority="must">
      <statement>Core services operate without network access for any document version covered by bundled schemas.</statement>
    </goal>
    <goal id="GOAL-LOW-FRICTION" title="Low-friction installation" priority="must">
      <statement>A developer or agent can install the skill by cloning the repository; no build step, package install, or compilation is required when xmllint or lxml is already present.</statement>
    </goal>
    <qgoal id="QGOAL-FAST-ACTIVATION" title="Cheap activation" priority="should">
      <statement>SKILL.md activates with a small token cost and loads detail progressively from references/.</statement>
      <metric>SKILL.md body at most 5000 tokens and 500 lines.</metric>
    </qgoal>
    <qgoal id="QGOAL-FAST-VALIDATE" title="Fast validation" priority="should">
      <statement>Validation runs fast enough to invoke after every edit without disrupting flow.</statement>
      <metric>scripts/validate.py completes in under 2 seconds for documents up to 2000 lines.</metric>
    </qgoal>
  </goals>

  <scenarios>
    <scenario id="SCN-VALIDATE" title="Validate after edit" actorRef="ACT-AGENT">
      <narrative>The agent edits requirements.rqml and runs scripts/validate.py before completing the task to confirm the document is structurally valid and conforms to the declared schema version.</narrative>
    </scenario>
    <scenario id="SCN-AUTHOR" title="Scaffold a new requirement" actorRef="ACT-AGENT">
      <narrative>The agent invokes scripts/new_req.py to produce a valid req element with required attributes and an acceptance criterion, then inserts it into the document at the appropriate reqPackage.</narrative>
    </scenario>
    <scenario id="SCN-MATRIX" title="Generate traceability matrix" actorRef="ACT-DEVELOPER">
      <narrative>A developer or agent runs scripts/matrix.py to produce a markdown matrix mapping requirements to scenarios, goals, and verification, suitable for inclusion in pull request descriptions.</narrative>
    </scenario>
    <scenario id="SCN-OFFLINE" title="Run in sandbox without network" actorRef="ACT-AGENT">
      <narrative>The agent runs in a sandboxed environment without internet access. Validation succeeds because schemas are bundled in references/schemas/.</narrative>
    </scenario>
    <scenario id="SCN-OLD-SCHEMA" title="Project on older schema version" actorRef="ACT-AGENT">
      <narrative>A project's requirements.rqml declares version 2.0.1 while the skill's latest bundled version is 2.1.0. The skill detects the declared version and dispatches to the matching bundled schema rather than the latest.</narrative>
    </scenario>
    <scenario id="SCN-INSTALL" title="Install in a coding agent" actorRef="ACT-DEVELOPER">
      <narrative>A developer clones the rqml-skill repository into the agent's skills directory; the agent discovers SKILL.md on next activation and recognises trigger phrases on relevant tasks.</narrative>
    </scenario>
    <misuseCase id="SCN-DRIFT" title="Bundled schema drifts from upstream">
      <narrative>An upstream schema is patched at rqml.org but the bundled copy in the skill is not updated, causing validation to produce false positives or false negatives relative to the canonical schema.</narrative>
    </misuseCase>
    <edgeCase id="SCN-NO-TOOL" title="No XSD tooling available">
      <narrative>The agent's runtime lacks xmllint, lxml, and xmlschema. validate.py exits with a non-zero code and a clear instruction explaining how to install at least one backend.</narrative>
    </edgeCase>
  </scenarios>

  <requirements>
    <reqPackage id="PKG-SKILL" title="Skill structure">
      <req id="REQ-SKILL-MD" type="FR" title="SKILL.md compliance" priority="must" status="approved">
        <statement>The skill SHALL ship a SKILL.md file with YAML frontmatter conforming to the Agent Skills specification, including required name and description fields.</statement>
        <acceptance>
          <criterion id="CRIT-SKILL-MD-1">
            <when>The agentskills reference validator is run against SKILL.md</when>
            <then>It reports valid frontmatter and no schema violations.</then>
          </criterion>
        </acceptance>
      </req>
      <req id="REQ-TRIGGERS" type="FR" title="Trigger phrases in description" priority="must" status="approved">
        <statement>The SKILL.md description SHALL include front-loaded trigger phrases including "rqml", ".rqml file", "requirements specification", and "traceability" so that implicit invocation by description matching reliably activates the skill.</statement>
      </req>
      <req id="REQ-TOKEN-BUDGET" type="NFR" title="SKILL.md token budget" priority="must" status="approved">
        <statement>The SKILL.md body SHALL be no more than 5000 tokens and no more than 500 lines, with detailed material moved to references/.</statement>
      </req>
      <req id="REQ-LAYOUT" type="FR" title="Directory layout" priority="must" status="approved">
        <statement>The skill SHALL provide references/, scripts/, assets/, and tests/ subdirectories with the conventional Agent Skills meanings.</statement>
      </req>
    </reqPackage>

    <reqPackage id="PKG-VALIDATE" title="XSD validation services">
      <req id="REQ-XSD-VALIDATE" type="FR" title="XSD validation script" priority="must" status="approved">
        <statement>The skill SHALL provide scripts/validate.py that validates a target .rqml file against the schema version declared in its rqml@version attribute.</statement>
        <acceptance>
          <criterion id="CRIT-XSD-1">
            <given>A .rqml file that conforms to its declared schema version</given>
            <when>scripts/validate.py is invoked against it</when>
            <then>Exit code is 0 and stdout reports a valid result with the chosen backend and schema path.</then>
          </criterion>
          <criterion id="CRIT-XSD-2">
            <given>A .rqml file that violates its declared schema</given>
            <when>scripts/validate.py is invoked against it</when>
            <then>Exit code is 1 and stderr lists each violation with line number, optional column, element path, and human-readable message.</then>
          </criterion>
        </acceptance>
      </req>
      <req id="REQ-FALLBACK" type="FR" title="Validation tool fallback chain" priority="must" status="approved">
        <statement>validate.py SHALL attempt xmllint first; if absent, lxml; if absent, xmlschema; and if none are available, exit with a non-zero code and a clear install instruction.</statement>
        <acceptance>
          <criterion id="CRIT-FALLBACK-1">
            <given>xmllint is not on PATH but lxml is installed</given>
            <when>scripts/validate.py runs</when>
            <then>Validation completes successfully and the report names lxml as the chosen backend.</then>
          </criterion>
          <criterion id="CRIT-FALLBACK-2">
            <given>None of xmllint, lxml, or xmlschema are available</given>
            <when>scripts/validate.py runs</when>
            <then>The script exits with code 2 and prints installation guidance covering all three options.</then>
          </criterion>
        </acceptance>
      </req>
      <req id="REQ-VERSION-DETECT" type="FR" title="Schema version dispatch" priority="must" status="approved">
        <statement>validate.py SHALL read rqml@version from the document under test and select references/schemas/rqml-{version}.xsd as the validation schema; a --schema-version flag SHALL override this auto-detection.</statement>
        <acceptance>
          <criterion id="CRIT-VERSION-1">
            <given>A document declaring version 2.0.1 and a skill bundling both 2.0.1 and 2.1.0</given>
            <when>scripts/validate.py runs without --schema-version</when>
            <then>Validation uses references/schemas/rqml-2.0.1.xsd.</then>
          </criterion>
        </acceptance>
      </req>
      <req id="REQ-BUNDLE" type="FR" title="Bundled schema versions" priority="must" status="approved">
        <statement>The skill SHALL bundle every supported RQML schema version under references/schemas/ so that validation works without network access.</statement>
      </req>
      <req id="REQ-JSON-OUT" type="FR" title="Structured validation output" priority="must" status="approved">
        <statement>validate.py SHALL emit a structured JSON report when invoked with --json: an object with backend, schema, and an errors array, where each error has line, column, path, message, severity, and an optional suggestion field.</statement>
      </req>
      <req id="REQ-OFFLINE" type="OR" title="Offline operation" priority="must" status="approved">
        <statement>Validation SHALL succeed without network access whenever the document's declared version is covered by a bundled schema.</statement>
      </req>
    </reqPackage>

    <reqPackage id="PKG-SEMANTIC" title="Semantic and trace services">
      <req id="REQ-TRACE-CHECK" type="FR" title="Trace target resolution" priority="should" status="approved">
        <statement>scripts/check_traces.py SHALL resolve trace edge locators of type doc and external against the local filesystem and HTTP respectively, reporting any unresolved targets.</statement>
      </req>
      <req id="REQ-LINT" type="FR" title="Strictness-aware semantic lint" priority="should" status="approved">
        <statement>scripts/lint.py SHALL apply checks parameterised by the project's strictness level: standard requires acceptance criteria on every requirement; strict additionally requires trace edges on every change; certified additionally requires createdBy, createdAt, and confidence on every trace edge.</statement>
      </req>
      <req id="REQ-ID-AUDIT" type="FR" title="ID audit" priority="should" status="approved">
        <statement>scripts/id_audit.py SHALL detect duplicate IDs, IDs not conforming to project naming convention, and IDs that have changed since the previous version of the document under git.</statement>
      </req>
      <req id="REQ-MATRIX" type="FR" title="Traceability matrix generation" priority="should" status="approved">
        <statement>scripts/matrix.py SHALL produce a markdown traceability matrix mapping each requirement to its trace edges, grouped by edge type (satisfies, dependsOn, mitigates, verifiedBy).</statement>
      </req>
      <req id="REQ-EXTRACT" type="FR" title="Requirement extraction" priority="should" status="approved">
        <statement>scripts/extract.py SHALL emit a JSON array of requirement objects, each containing id, type, title, priority, status, and statement, suitable for piping into other agent tools.</statement>
      </req>
    </reqPackage>

    <reqPackage id="PKG-PLATFORM" title="Runtime and platform support">
      <req id="REQ-PYTHON" type="OR" title="Python runtime" priority="must">
        <statement>All scripts SHALL run on Python 3.8 or later without requiring third-party packages beyond what is already available in standard Python 3 distributions, except where explicitly listed in scripts/requirements.txt as optional acceleration.</statement>
      </req>
      <req id="REQ-PLATFORM" type="OR" title="OS support" priority="must">
        <statement>All scripts SHALL run on macOS, Linux, and Windows without modification, using only standard-library APIs for filesystem and process operations.</statement>
      </req>
      <req id="REQ-NO-INSTALL" type="NFR" title="Zero build step" priority="must" status="approved">
        <statement>The skill SHALL be usable immediately after git clone when xmllint or lxml is already present in the agent's environment, without compilation or pip install.</statement>
      </req>
    </reqPackage>

    <reqPackage id="PKG-LICENSING" title="Licensing and provenance">
      <req id="REQ-LICENSE" type="OR" title="Apache-2.0" priority="must" status="approved">
        <statement>The skill SHALL be licensed under Apache-2.0 to match the upstream RQML standard and the Agent Skills standard.</statement>
      </req>
      <req id="REQ-PROVENANCE" type="OR" title="Schema provenance check" priority="should" status="approved">
        <statement>CI SHALL fetch each upstream schema from rqml.org weekly and assert byte-equality against the bundled copy; mismatches block the next release.</statement>
      </req>
    </reqPackage>
  </requirements>

  <verification>
    <testSuite id="TS-SKILL" title="Skill self-tests">
      <description>Fixtures under tests/fixtures/ exercise valid and invalid documents against each bundled schema version, plus environment scenarios for the validation fallback chain.</description>
    </testSuite>
    <testCase id="TC-VALID" type="integration" title="Valid 2.1.0 document">
      <steps>Run scripts/validate.py against tests/fixtures/valid-2.1.0.rqml.</steps>
      <expected>Exit code 0; JSON report with empty errors array and backend named.</expected>
    </testCase>
    <testCase id="TC-INVALID-MISSING" type="integration" title="Document missing required attribute">
      <steps>Run scripts/validate.py against tests/fixtures/invalid-missing-version.rqml.</steps>
      <expected>Exit code 1; at least one error referencing rqml@version with line and column.</expected>
    </testCase>
    <testCase id="TC-FALLBACK" type="integration" title="Fallback to lxml when xmllint absent">
      <steps>Remove xmllint from PATH in the test environment; run validate.py against a valid fixture.</steps>
      <expected>Exit code 0; report identifies lxml as the chosen backend.</expected>
    </testCase>
    <testCase id="TC-NO-TOOL" type="integration" title="Clear error when no backend available">
      <steps>Mock xmllint, lxml, and xmlschema as unavailable; run validate.py.</steps>
      <expected>Exit code 2; message lists installation options for all three backends.</expected>
    </testCase>
    <testCase id="TC-OLD-SCHEMA" type="integration" title="Auto-dispatch to 2.0.1 schema">
      <steps>Run validate.py against tests/fixtures/valid-2.0.1.rqml without --schema-version.</steps>
      <expected>Exit code 0; report identifies references/schemas/rqml-2.0.1.xsd as the schema.</expected>
    </testCase>
    <testCase id="TC-OFFLINE" type="integration" title="Validation succeeds offline">
      <steps>Run validate.py with network egress blocked at the kernel level.</steps>
      <expected>Exit code 0; no network calls observed.</expected>
    </testCase>
    <testCase id="TC-MATRIX" type="integration" title="Matrix generation">
      <steps>Run scripts/matrix.py against tests/fixtures/valid-2.1.0.rqml.</steps>
      <expected>Markdown table on stdout with one row per requirement and columns per trace type.</expected>
    </testCase>
    <testCase id="TC-AGENTSKILLS" type="security" title="SKILL.md spec compliance">
      <steps>Run the agentskills reference validator against the skill's SKILL.md.</steps>
      <expected>Validator reports zero errors.</expected>
    </testCase>
    <testCase id="TC-PROVENANCE" type="security" title="Bundled schema matches upstream">
      <steps>CI job fetches each schema from rqml.org and diffs it byte-for-byte against the bundled copy.</steps>
      <expected>Diffs are empty for every supported version.</expected>
    </testCase>
    <testCase id="TC-PERFORMANCE" type="performance" title="Validation latency">
      <steps>Run validate.py against a 2000-line valid fixture using each backend.</steps>
      <expected>Total elapsed wall-clock time under 2 seconds for xmllint and lxml backends.</expected>
    </testCase>
  </verification>

  <trace>
    <!-- Goals satisfied by requirements -->
